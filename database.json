    "pagesText": {
        "gioithieu": {
            "title": "📖 Giới thiệu về Tiệm Bánh Ngọt",
            "content": "Tiệm Bánh Ngọt ra đời từ niềm đam mê làm bánh và mong muốn mang đến niềm vui ngọt ngào cho mọi người. Mỗi chiếc bánh đều được làm từ nguyên liệu tươi ngon nhất, không chất bảo quản, đảm bảo hương vị tự nhiên và an toàn. Chúng tôi tin rằng một chiếc bánh ngon có thể làm bừng sáng cả một ngày!"
        },
        "giaodich": {
            "title": "🤝 Hướng dẫn giao dịch",
            "content": "1. Chọn món ăn bạn yêu thích ở Trang Chủ và ấn 'Thêm vào giỏ hàng'.\n2. Bấm vào biểu tượng Giỏ Hàng để kiểm tra lại các món đã chọn và tổng số tiền.\n3. Điền thông tin giao hàng (Tên, Số điện thoại, Địa chỉ).\n4. Bấm 'Xác nhận đặt hàng' và đợi chúng tôi giao tới nhé."
        },
        "thanhtoan": {
            "title": "💳 Chính sách thanh toán",
            "content": "Hiện tại Tiệm Bánh Ngọt hỗ trợ 2 hình thức thanh toán chính:\n- Thanh toán tiền mặt khi nhận hàng (Ship COD).\n- Chuyển khoản qua số tài khoản ngân hàng (Thông tin sẽ được cung cấp sau khi xác nhận đơn hàng)."
        },
        "vanchuyen": {
            "title": "🚚 Chính sách vận chuyển",
            "content": "- Giao hàng nhanh chóng trong vòng 45 phút đối với bán kính 5km.\n- Đồng giá phí ship 20,000đ cho mọi đơn hàng nội thành.\n- MIỄN PHÍ vận chuyển cho tất cả hóa đơn trên 300,000 VNĐ."
        },
